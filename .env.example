# Elasticsearch (Conversation Memory). Use ES_URL or ES_CLOUD_ID, plus ES_API_KEY (preferred) or ES_USER/ES_PASSWORD.
ES_URL=
ES_CLOUD_ID=
ES_API_KEY=
ES_USER=
ES_PASSWORD=
ES_SEGMENT_INDEX=soundbubble-segments
ES_CONVERSATION_INDEX=soundbubble-conversations
# Embedding model (must stay the same for indexing and querying) and ASR model
SB_EMBED_MODEL=sentence-transformers/all-MiniLM-L6-v2
SB_EMBED_DIMS=384
SB_ASR_MODEL=base.en
# Extraction
SB_ENABLE_TSE=1
SB_MODEL_DIR=models/spk_emb_100
SB_DATA_DIR=data/store
# Optional: remote SoundBubble (e.g. the Kubernetes deployment) to archive saved conversations to
SB_ARCHIVE_URL=
SB_ARCHIVE_TOKEN=
